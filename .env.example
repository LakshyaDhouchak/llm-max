# LLM Max — environment variables
#
# Not needed for Phase 1 (llm-max CLI works standalone, zero services).
# Copy to .env and fill in once Phase 2 (MySQL/Redis) or later phases land
# and you're using docker-compose.


# --- MySQL (Phase 2) ---
MYSQL_HOST=localhost
MYSQL_PORT=3307          # <-- changed from 3306 to avoid conflict
MYSQL_DATABASE=llm_max
MYSQL_USER=llm_max
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme


# --- Redis (Phase 2) ---
REDIS_HOST=localhost
REDIS_PORT=6379          # <-- keep as 6379 (no conflict)
REDIS_PASSWORD=


# --- Ollama (Phase 1, already the default) ---
OLLAMA_BASE_URL=http://localhost:11434


# --- Kafka + Schema Registry (Phase 5, optional) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
LLM_MAX_TELEMETRY_ENABLED=false


# --- Web UI (Phase 4) ---
WEBUI_BACKEND_PORT=8080
AGENTD_URL=http://localhost:8000